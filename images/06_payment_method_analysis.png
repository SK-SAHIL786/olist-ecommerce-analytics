
payment_data = payments.groupby(
    "payment_type"
)["payment_value"].sum().sort_values(ascending=False)

plt.figure(figsize=(9, 6))
plt.bar(payment_data.index, payment_data.values,
        color=[CYAN, PURPLE, BLUE, PINK, ORANGE][:len(payment_data)])

plt.title("Payment Method Analysis", fontsize=17)
plt.xlabel("Payment Method")
plt.ylabel("Payment Value (R$)")

plt.tight_layout()
plt.savefig(IMAGE_DIR / "05_payment_method_analysis.png",
            dpi=200, facecolor=BG)
plt.show()

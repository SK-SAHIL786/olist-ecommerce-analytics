
delivery_check = delivered_orders.dropna(
    subset=["order_delivered_customer_date",
            "order_estimated_delivery_date"]
).copy()

delivery_check["delivery_status"] = np.where(
    delivery_check["order_delivered_customer_date"] >
    delivery_check["order_estimated_delivery_date"],
    "Late", "On Time"
)

delivery_counts = delivery_check[
    "delivery_status"
].value_counts()

plt.figure(figsize=(8, 6))
delivery_counts.plot(
    kind="bar",
    color=[CYAN, ORANGE]
)

plt.title("On-time vs Late Delivery", fontsize=17)
plt.xlabel("Delivery Status")
plt.ylabel("Orders")
plt.xticks(rotation=0)

plt.tight_layout()
plt.savefig(IMAGE_DIR / "13_on_time_vs_late_delivery.png",
            dpi=200, facecolor=BG)
plt.show()


delivery_days = (
    delivered_orders["order_delivered_customer_date"]
    - delivered_orders["order_purchase_timestamp"]
).dt.total_seconds() / 86400

delivery_days = delivery_days.dropna()
delivery_days = delivery_days[delivery_days >= 0]

plt.figure(figsize=(11, 6))
plt.hist(delivery_days, bins=40, color=ORANGE, edgecolor=BG)

plt.title("Delivery Time Distribution", fontsize=17)
plt.xlabel("Delivery Days")
plt.ylabel("Number of Orders")

plt.tight_layout()
plt.savefig(IMAGE_DIR / "12_delivery_time_distribution.png",
            dpi=200, facecolor=BG)
plt.show()

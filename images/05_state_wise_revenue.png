
state_data = customers.merge(
    delivered_orders[["order_id", "customer_id"]],
    on="customer_id"
).merge(items, on="order_id")

state_revenue = (
    state_data.groupby("customer_state")["price"]
    .sum()
    .nlargest(10)
    .sort_values()
)

plt.figure(figsize=(11, 6))
state_revenue.plot(kind="barh", color=BLUE)

plt.title("Top 10 States by Revenue", fontsize=17)
plt.xlabel("Revenue (R$)")
plt.ylabel("Customer State")

plt.tight_layout()
plt.savefig(IMAGE_DIR / "04_state_wise_revenue.png",
            dpi=200, facecolor=BG)
plt.show()

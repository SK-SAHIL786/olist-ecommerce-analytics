
avg_review = reviews["review_score"].mean()

avg_delivery = (
    delivered_orders["order_delivered_customer_date"]
    - delivered_orders["order_purchase_timestamp"]
).dt.total_seconds().div(86400).mean()

repeat_count = (
    customers.merge(orders, on="customer_id")
    .query("order_status == 'delivered'")
    .groupby("customer_unique_id")["order_id"]
    .nunique().gt(1).sum()
)

fig, ax = plt.subplots(figsize=(13, 6))
ax.axis("off")

kpis = [
    ("DELIVERED REVENUE", f"R$ {total_revenue/1e6:.2f}M", CYAN),
    ("DELIVERED ORDERS", f"{total_orders:,}", PURPLE),
    ("AVG REVIEW SCORE", f"{avg_review:.2f}/5", PINK),
    ("AVG DELIVERY DAYS", f"{avg_delivery:.2f}", ORANGE),
    ("REPEAT CUSTOMERS", f"{repeat_count:,}", BLUE)
]

for i, (label, value, color) in enumerate(kpis):
    x = 0.02 + i * 0.195
    ax.text(x, 0.65, label, transform=ax.transAxes,
            fontsize=9, color=WHITE)
    ax.text(x, 0.43, value, transform=ax.transAxes,
            fontsize=17, weight="bold", color=color)

ax.text(0.02, 0.12, "OLIST EXECUTIVE OVERVIEW",
        transform=ax.transAxes, fontsize=22,
        weight="bold", color=CYAN)

plt.savefig(IMAGE_DIR / "01_executive_overview.png",
            dpi=200, bbox_inches="tight", facecolor=BG)
plt.show()

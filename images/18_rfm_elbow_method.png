
inertias = []

for k in range(1, 9):
    model = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )
    model.fit(rfm_scaled)
    inertias.append(model.inertia_)

plt.figure(figsize=(9, 5))
plt.plot(range(1, 9), inertias,
         marker="o", color=CYAN, linewidth=2)

plt.title("RFM Clustering - Elbow Method", fontsize=17)
plt.xlabel("Number of Clusters")
plt.ylabel("Inertia")
plt.xticks(range(1, 9))
plt.grid(alpha=0.15)

plt.tight_layout()
plt.savefig(IMAGE_DIR / "17_rfm_elbow_method.png",
            dpi=200, facecolor=BG)
plt.show()
